\@writefile{lof}{\contentsline {figure}{\numberline {A2}{\ignorespaces \textbf  {Why the gate is not ordinary collider bias: a structural \emph  {positivity} violation induced by inherited-effect screening, which is why the remedy is a design and not an estimator.} This is the figure for §\ref {sec:testability}'s argument. (a) Conditioning on a descendant $G$ of both the mechanism $P$ and the defense's standalone strength $S$ makes them co-vary: every cell stays populated, so an adjustment recovers the estimand in principle. (b) Here C0$\wedge $C1 make the gate \emph  {deterministic} in $S$ (Lemma~\ref {lem:testability}), so the column the identifying contrast needs is empty for every defense menu, and no adjustment set, no reweighting and no sample size restores it (Proposition~\ref {prop:identification}).}}{19}{figure.caption.22}\protected@file@percent }
\newlabel{fig:identification}{{A2}{19}{\textbf {Why the gate is not ordinary collider bias: a structural \emph {positivity} violation induced by inherited-effect screening, which is why the remedy is a design and not an estimator.} This is the figure for §\ref {sec:testability}'s argument. (a) Conditioning on a descendant $G$ of both the mechanism $P$ and the defense's standalone strength $S$ makes them co-vary: every cell stays populated, so an adjustment recovers the estimand in principle. (b) Here C0$\wedge $C1 make the gate \emph {deterministic} in $S$ (Lemma~\ref {lem:testability}), so the column the identifying contrast needs is empty for every defense menu, and no adjustment set, no reweighting and no sample size restores it (Proposition~\ref {prop:identification})}{figure.caption.22}{}}
