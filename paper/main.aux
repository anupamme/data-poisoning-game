\@writefile{toc}{\contentsline {paragraph}{A second dataset and a differently configured CNN, pre-registered.}{43}{section*.45}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {A12}{\ignorespaces \textbf  {The four channels, all four aggregators, under Mode~S.} Endpoint change $\kappa {=}0 \to \kappa {=}2$. \textbf  {The first column, $\Delta $~agg., is the relative displacement of the aggregate the defense \emph  {emits}}, $\|\mathrm  {agg}(T(U)) - \mathrm  {agg}(U)\|/\|\mathrm  {agg}(U)\|$: what enters training, and \textbf  {not} the value of a scoring statistic; the measured channels are aggregate displacement, decision, admission and influence. The dissociation between the \emph  {decision} channel and the \emph  {admission} channel is not a property of one aggregator: it holds for a selector, a cosine-invariant selector, a coordinate-wise order statistic and a weighted averager. The table does \textbf  {not} order the arms ($\Delta \Lambda _a$ and $\Delta $ASR disagree in rank, which is this section's refutation stated in one row-pair) and it is \emph  {not} an out-of-sample test: all rows are Mode-S ladders reported elsewhere in this paper. \textbf  {The sixth row is the score-only control}: the same arm as the first with the magnitude channel closed, so its $\Delta $~agg.\ is the re-selection component alone and its decision, admission and influence columns are the first row's own numbers, score-only leaving the selection untouched. \textbf  {The seventh row varies architecture alone}: the first row's cell on \texttt  {resnet18} instead of \texttt  {cifar\_cnn}, with dataset, $N$, $K$, $f$, $\alpha $, attack and defense all at their frozen CIFAR-10 values, so it is the only row that differs from the first in a single factor. Its channel columns were measured \emph  {prospectively} --- \texttt  {results/\allowbreak  resnet18\_\allowbreak  admission.json} records ``No ASR. Freezes nothing.'' and predates every ResNet18 ASR in this paper --- and its two unrun interior rungs are why §\ref {app:resnet18_dose} reports no trend statistic for it. \textbf  {$n$ is the seed count behind the $\Delta $~ASR column and nothing else}: the channel columns are per-round measurements, whose counts are given above. It is emitted per row as \texttt  {n\_seeds} $= \min (n_0,n_2)$ over the row's two rungs and it is \textbf  {not uniform}, reading $3$ for the second-dataset replication and $8$ for \texttt  {cos\_krum}. The emitter also records \texttt  {seeds\_match} on the six rows whose two rungs come from one paired suite, and it is true on all six; the score-only row's ASR is read from a separate directory, so it carries no such field.}}{44}{table.caption.44}\protected@file@percent }
\newlabel{tab:channels_full}{{A12}{44}{\textbf {The four channels, all four aggregators, under Mode~S.} Endpoint change $\kappa {=}0 \to \kappa {=}2$. \textbf {The first column, $\Delta $~agg., is the relative displacement of the aggregate the defense \emph {emits}}, $\|\mathrm {agg}(T(U)) - \mathrm {agg}(U)\|/\|\mathrm {agg}(U)\|$: what enters training, and \textbf {not} the value of a scoring statistic; the measured channels are aggregate displacement, decision, admission and influence. The dissociation between the \emph {decision} channel and the \emph {admission} channel is not a property of one aggregator: it holds for a selector, a cosine-invariant selector, a coordinate-wise order statistic and a weighted averager. The table does \textbf {not} order the arms ($\Delta \Lambda _a$ and $\Delta $ASR disagree in rank, which is this section's refutation stated in one row-pair) and it is \emph {not} an out-of-sample test: all rows are Mode-S ladders reported elsewhere in this paper. \textbf {The sixth row is the score-only control}: the same arm as the first with the magnitude channel closed, so its $\Delta $~agg.\ is the re-selection component alone and its decision, admission and influence columns are the first row's own numbers, score-only leaving the selection untouched. \textbf {The seventh row varies architecture alone}: the first row's cell on \texttt {resnet18} instead of \texttt {cifar\_cnn}, with dataset, $N$, $K$, $f$, $\alpha $, attack and defense all at their frozen CIFAR-10 values, so it is the only row that differs from the first in a single factor. Its channel columns were measured \emph {prospectively} --- \texttt {results/\allowbreak resnet18\_\allowbreak admission.json} records ``No ASR. Freezes nothing.'' and predates every ResNet18 ASR in this paper --- and its two unrun interior rungs are why §\ref {app:resnet18_dose} reports no trend statistic for it. \textbf {$n$ is the seed count behind the $\Delta $~ASR column and nothing else}: the channel columns are per-round measurements, whose counts are given above. It is emitted per row as \texttt {n\_seeds} $= \min (n_0,n_2)$ over the row's two rungs and it is \textbf {not uniform}, reading $3$ for the second-dataset replication and $8$ for \texttt {cos\_krum}. The emitter also records \texttt {seeds\_match} on the six rows whose two rungs come from one paired suite, and it is true on all six; the score-only row's ASR is read from a separate directory, so it carries no such field}{table.caption.44}{}}
