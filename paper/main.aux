\newlabel{sec:dose_outcome}{{E.1}{30}{Outcome of the confounded design: one arm confirmed, two refuted, one indeterminate, and the pooled test fails}{subsection.E.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A9}{\ignorespaces The dose--response ladder as measured, $n{=}5$ per cell, per-attack mean ASR with mean clean accuracy in parentheses. \emph  {Predicted} is the shape frozen at commit \texttt  {e711a95} before any run; $p_{\uparrow }$ is the one-sided Jonckheere--Terpstra probability for an \emph  {increasing} trend across the four ordered rungs, which is the only direction any frozen rule tests. Verdicts apply the frozen criteria unchanged (Table~\ref {tab:dose_design} and the supplement \S  ~\ref {app:dose_protocol}); an arm satisfying neither its confirmation nor its refutation criterion is reported as \emph  {indeterminate} rather than scored in our favour. $^{\dagger }$ below the $0.35$ clean-accuracy gate: a collapsed model, not suppression. Student-t 95\% intervals and per-seed values are in the supplement (\S  ~\ref {app:dose_detail}).}}{30}{table.caption.30}\protected@file@percent }
\newlabel{tab:dose_outcome}{{A9}{30}{The dose--response ladder as measured, $n{=}5$ per cell, per-attack mean ASR with mean clean accuracy in parentheses. \emph {Predicted} is the shape frozen at commit \texttt {e711a95} before any run; $p_{\uparrow }$ is the one-sided Jonckheere--Terpstra probability for an \emph {increasing} trend across the four ordered rungs, which is the only direction any frozen rule tests. Verdicts apply the frozen criteria unchanged (Table~\ref {tab:dose_design} and the supplement \S ~\ref {app:dose_protocol}); an arm satisfying neither its confirmation nor its refutation criterion is reported as \emph {indeterminate} rather than scored in our favour. $^{\dagger }$ below the $0.35$ clean-accuracy gate: a collapsed model, not suppression. Student-t 95\% intervals and per-seed values are in the supplement (\S ~\ref {app:dose_detail})}{table.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A3}{\ignorespaces \textbf  {Why a transform's flip rate is not a sufficient statistic for what it does.} ASR against the \emph  {independently measured} disturbance of each arm's own statistic ($n{=}5$, Student-t 95\% intervals), the abscissa fixed before the freeze. Stars and crosses are the two \emph  {real} upstream transforms measured on these same $(d_2, \text  {attack})$ cells (NormClip, RFA), placed at their own measured disturbance rate: at matched disturbance they sit $+0.77$ and $+0.79$ ASR \emph  {above} the synthetic curve, while their realized weight ratios (mean $3.61$ and $11.93$, maximum $4.90$ and $17.38$) fall \emph  {inside} the ladder's span, which is why we conclude that flip rate does not determine what a transform does to a defense. The class-(a) arm's four rungs coincide at disturbance exactly $0$ ($0/120$ selections changed, maximum relative score drift $1.1\times 10^{-4}$) and its ASR falls anyway: Lemma~\ref {lem:annihilation}'s magnitude channel, not C2 disturbance.}}{31}{figure.caption.32}\protected@file@percent }
\newlabel{fig:dose_measured}{{A3}{31}{\textbf {Why a transform's flip rate is not a sufficient statistic for what it does.} ASR against the \emph {independently measured} disturbance of each arm's own statistic ($n{=}5$, Student-t 95\% intervals), the abscissa fixed before the freeze. Stars and crosses are the two \emph {real} upstream transforms measured on these same $(d_2, \text {attack})$ cells (NormClip, RFA), placed at their own measured disturbance rate: at matched disturbance they sit $+0.77$ and $+0.79$ ASR \emph {above} the synthetic curve, while their realized weight ratios (mean $3.61$ and $11.93$, maximum $4.90$ and $17.38$) fall \emph {inside} the ladder's span, which is why we conclude that flip rate does not determine what a transform does to a defense. The class-(a) arm's four rungs coincide at disturbance exactly $0$ ($0/120$ selections changed, maximum relative score drift $1.1\times 10^{-4}$) and its ASR falls anyway: Lemma~\ref {lem:annihilation}'s magnitude channel, not C2 disturbance}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A4}{\ignorespaces \textbf  {Mode~A, the payload dose: the two mechanism-preserving regimes, and where they hold.} With dispersion fixed and only the adversary/benign weight ratio $r$ swept, \texttt  {coord\_median} (a rank aggregator, the case Theorem~\ref {thm:bounded_reweight}'s regimes are stated over) is \textbf  {single-peaked at $r{=}1$} as the theorem predicts (over-attenuated adversaries carry no payload, over-amplified ones are discarded) while reputation is monotone, off-spec and refuted for that shape. Mode~A is the $\Delta _c$-\emph  {swept} companion to Mode~S's $\Delta _c$-pinned design (Proposition~\ref {prop:rho_deltac}); Mode~S itself is Figure~\ref {fig:modeS}. Bars are Student-$t$ $95\%$ intervals; numbers recomputed per seed by \texttt  {analyze\_targeted\_dose.py}.}}{32}{figure.caption.33}\protected@file@percent }
\newlabel{fig:modeA}{{A4}{32}{\textbf {Mode~A, the payload dose: the two mechanism-preserving regimes, and where they hold.} With dispersion fixed and only the adversary/benign weight ratio $r$ swept, \texttt {coord\_median} (a rank aggregator, the case Theorem~\ref {thm:bounded_reweight}'s regimes are stated over) is \textbf {single-peaked at $r{=}1$} as the theorem predicts (over-attenuated adversaries carry no payload, over-amplified ones are discarded) while reputation is monotone, off-spec and refuted for that shape. Mode~A is the $\Delta _c$-\emph {swept} companion to Mode~S's $\Delta _c$-pinned design (Proposition~\ref {prop:rho_deltac}); Mode~S itself is Figure~\ref {fig:modeS}. Bars are Student-$t$ $95\%$ intervals; numbers recomputed per seed by \texttt {analyze\_targeted\_dose.py}}{figure.caption.33}{}}
