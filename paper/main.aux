\@writefile{toc}{\contentsline {paragraph}{Mode~M: coordinate masking, a second transformation class.}{48}{section*.48}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {A13}{\ignorespaces \textbf  {The same aggregators under two transformation classes, every prediction frozen before its measurement.} Prop.~\ref {prop:invariance} classifies aggregators under \emph  {positive per-client rescaling} only; coordinate masking is outside that family, so Thm.~\ref {thm:bounded_reweight} and Prop.~\ref {prop:invariance} make \textbf  {no} prediction there, which is what makes the second class a test rather than a second demonstration. Rescaling predictions were frozen at \texttt  {5130cec}, masking predictions at \texttt  {684b31e}, each before the corresponding run existed; \texttt  {experiments/build\_prediction\_matrix.py} refuses to emit if any observed cell disagrees with its frozen document. \textbf  {\texttt  {cos\_krum} is the adjudicating row}: exactly invariant under rescaling, its selection bit-identical at every rung, it loses the guarantee under masking on the same attack and the same seeds, which is what it means for the classification to be a statement about a transformation \emph  {class} and not about an aggregator. \textbf  {Every cell in this table is a decision-channel measurement, not an ASR}: under masking, ASR is measured for \texttt  {krum} alone (§\ref {app:channel_table}), so the other three masking rows are channel-only and this table carries no ASR column to report them in.}}{49}{table.caption.49}\protected@file@percent }
\newlabel{tab:prediction_matrix}{{A13}{49}{\textbf {The same aggregators under two transformation classes, every prediction frozen before its measurement.} Prop.~\ref {prop:invariance} classifies aggregators under \emph {positive per-client rescaling} only; coordinate masking is outside that family, so Thm.~\ref {thm:bounded_reweight} and Prop.~\ref {prop:invariance} make \textbf {no} prediction there, which is what makes the second class a test rather than a second demonstration. Rescaling predictions were frozen at \texttt {5130cec}, masking predictions at \texttt {684b31e}, each before the corresponding run existed; \texttt {experiments/build\_prediction\_matrix.py} refuses to emit if any observed cell disagrees with its frozen document. \textbf {\texttt {cos\_krum} is the adjudicating row}: exactly invariant under rescaling, its selection bit-identical at every rung, it loses the guarantee under masking on the same attack and the same seeds, which is what it means for the classification to be a statement about a transformation \emph {class} and not about an aggregator. \textbf {Every cell in this table is a decision-channel measurement, not an ASR}: under masking, ASR is measured for \texttt {krum} alone (§\ref {app:channel_table}), so the other three masking rows are channel-only and this table carries no ASR column to report them in}{table.caption.49}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {E.3}Seven cells, and a pre-registered mechanism that did not survive them}{49}{subsection.E.3}\protected@file@percent }
\newlabel{app:sixcell}{{E.3}{49}{Seven cells, and a pre-registered mechanism that did not survive them}{subsection.E.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A14}{\ignorespaces \textbf  {The confounded ladder against the Mode-S instrument, on seven cells.} $\Delta $~ASR from $\kappa {=}0$ to $\kappa {=}2$, paired $95\%$ $t$ intervals, each design at its own full $n$, \textbf  {which the $n$ column now prints as confounded/controlled} so the strongest row and the weakest are distinguishable on the page. \textbf  {Row~4, the sign reversal, is the one row at $n{=}20$ on both legs}, following a pre-registered endpoint top-up (seeds $47$--$61$, \texttt  {experiments/\allowbreak  pre\_registration\_reversal\_seed\_topup.md}); at the frozen $n{=}5$ it read $-0.272$ {$[-0.422,-0.122]$} against $+0.098$ {$[+0.018,+0.178]$}, the same verdict by the same definition. \textbf  {AGREE} := intervals overlap and point estimates share a sign, or both lie within $\pm 0.05$ of zero; \textbf  {DISAGREE} := intervals disjoint or signs opposite; \textbf  {SIGN REVERSAL} := signs differ \emph  {and} both intervals exclude zero. The four unmarked cells are the training data the rule was read off. \textbf  {The rule predicted AGREE for the EMNIST cell and the designs disagree, so it is refuted}; per the frozen clause it is withdrawn, the four-cell pattern is demoted to a description, and the table is reported in full. \textbf  {The CIFAR-100 cell carries no prediction and its $\Delta \Lambda _a$ entry is absent rather than zero}, because the rule that would have generated one was already dead when that cell was pre-registered (Amendment~4); it is scored on the two endpoint rungs the primary contrast reads, and because no trend secondary was pre-registered for this table, the trend across all four rungs is reported as a \emph  {post hoc} description below rather than as a test here. Every cell emitted by \texttt  {analyze\_comparability.py}.}}{50}{table.caption.50}\protected@file@percent }
\newlabel{tab:sixcell}{{A14}{50}{\textbf {The confounded ladder against the Mode-S instrument, on seven cells.} $\Delta $~ASR from $\kappa {=}0$ to $\kappa {=}2$, paired $95\%$ $t$ intervals, each design at its own full $n$, \textbf {which the $n$ column now prints as confounded/controlled} so the strongest row and the weakest are distinguishable on the page. \textbf {Row~4, the sign reversal, is the one row at $n{=}20$ on both legs}, following a pre-registered endpoint top-up (seeds $47$--$61$, \texttt {experiments/\allowbreak pre\_registration\_reversal\_seed\_topup.md}); at the frozen $n{=}5$ it read $-0.272$ {$[-0.422,-0.122]$} against $+0.098$ {$[+0.018,+0.178]$}, the same verdict by the same definition. \textbf {AGREE} := intervals overlap and point estimates share a sign, or both lie within $\pm 0.05$ of zero; \textbf {DISAGREE} := intervals disjoint or signs opposite; \textbf {SIGN REVERSAL} := signs differ \emph {and} both intervals exclude zero. The four unmarked cells are the training data the rule was read off. \textbf {The rule predicted AGREE for the EMNIST cell and the designs disagree, so it is refuted}; per the frozen clause it is withdrawn, the four-cell pattern is demoted to a description, and the table is reported in full. \textbf {The CIFAR-100 cell carries no prediction and its $\Delta \Lambda _a$ entry is absent rather than zero}, because the rule that would have generated one was already dead when that cell was pre-registered (Amendment~4); it is scored on the two endpoint rungs the primary contrast reads, and because no trend secondary was pre-registered for this table, the trend across all four rungs is reported as a \emph {post hoc} description below rather than as a test here. Every cell emitted by \texttt {analyze\_comparability.py}}{table.caption.50}{}}
