\@writefile{lof}{\contentsline {figure}{\numberline {A5}{\ignorespaces \textbf  {Mode~S, the $\Delta _c$-pinned dose: Krum's statistic is disturbed, its admission of adversarial input is not, and suppression does not follow either.} The instrument of §\ref {sec:targeted} at the four rungs of the benign-dispersion dose, with every adversary's own weight pinned ($\Delta _c$ exactly $0$ at every rung, so the attenuation channel is cut by construction rather than controlled for): the selected client flips in up to $0.80$ of rounds, the admitted adversarial support changes in none of them, and max-committed ASR does not rise past the pre-registered $\pm 0.15$ practical-equivalence margin, whose lower side ASR's own floor already satisfies on this cell, so only the upper side is a test here (the supplement §\ref {par:reach}). It is the $\Delta _c$-pinned companion to the $\Delta _c$-swept Mode~A (Figure~\ref {fig:modeA}), and the same evidence Figure~\ref {fig:modeS}(a)'s middle annotation pools over four arms rather than Krum alone. Bars are Student-$t$ $95\%$ intervals, $n{=}5$; numbers recomputed per seed by \texttt  {analyze\_targeted\_dose.py}.}}{32}{figure.caption.36}\protected@file@percent }
\newlabel{fig:modeS_dose}{{A5}{32}{\textbf {Mode~S, the $\Delta _c$-pinned dose: Krum's statistic is disturbed, its admission of adversarial input is not, and suppression does not follow either.} The instrument of §\ref {sec:targeted} at the four rungs of the benign-dispersion dose, with every adversary's own weight pinned ($\Delta _c$ exactly $0$ at every rung, so the attenuation channel is cut by construction rather than controlled for): the selected client flips in up to $0.80$ of rounds, the admitted adversarial support changes in none of them, and max-committed ASR does not rise past the pre-registered $\pm 0.15$ practical-equivalence margin, whose lower side ASR's own floor already satisfies on this cell, so only the upper side is a test here (the supplement §\ref {par:reach}). It is the $\Delta _c$-pinned companion to the $\Delta _c$-swept Mode~A (Figure~\ref {fig:modeA}), and the same evidence Figure~\ref {fig:modeS}(a)'s middle annotation pools over four arms rather than Krum alone. Bars are Student-$t$ $95\%$ intervals, $n{=}5$; numbers recomputed per seed by \texttt {analyze\_targeted\_dose.py}}{figure.caption.36}{}}
