\@writefile{lot}{\contentsline {table}{\numberline {A16}{\ignorespaces Accuracy--security Pareto frontier. Max ASR = worst-case mean across committed attacks, and Clean Acc is measured on the arm that attains it. All at $N{=}10$, $K{=}5$, $f{=}0.2$, cifar\_cnn. The three composition rows are emitted by \texttt  {experiments/analyze\_headline\_cis.py}, each at the seed count its own max-committed arm carries: FG$\to $RFA and Rep$\to $CM at $n{=}30$ (seeds $42$--$71$; Rep$\to $CM's is the pre-registered pixel top-up, $0.463$ $[0.412,0.514]$), FG$\to $CM at $n{=}5$ (seeds $42$--$46$). No \emph  {composition} dominates another: FG$\to $CM buys $0.185$ accuracy for $+0.014$ ASR. The single-defense rows are listed for reference and are not all frontier points; \texttt  {Rep alone} dominates \texttt  {RFA alone} on both axes.}}{53}{table.caption.52}\protected@file@percent }
\newlabel{tab:pareto}{{A16}{53}{Accuracy--security Pareto frontier. Max ASR = worst-case mean across committed attacks, and Clean Acc is measured on the arm that attains it. All at $N{=}10$, $K{=}5$, $f{=}0.2$, cifar\_cnn. The three composition rows are emitted by \texttt {experiments/analyze\_headline\_cis.py}, each at the seed count its own max-committed arm carries: FG$\to $RFA and Rep$\to $CM at $n{=}30$ (seeds $42$--$71$; Rep$\to $CM's is the pre-registered pixel top-up, $0.463$ $[0.412,0.514]$), FG$\to $CM at $n{=}5$ (seeds $42$--$46$). No \emph {composition} dominates another: FG$\to $CM buys $0.185$ accuracy for $+0.014$ ASR. The single-defense rows are listed for reference and are not all frontier points; \texttt {Rep alone} dominates \texttt {RFA alone} on both axes}{table.caption.52}{}}
