\@writefile{lof}{\contentsline {figure}{\numberline {A6}{\ignorespaces \textbf  {Mode~A, the payload dose: the two mechanism-preserving regimes, and where they hold.} With dispersion fixed and only the adversary/benign weight ratio $r$ swept, \texttt  {coord\_median} (a rank aggregator, the case Theorem~\ref {thm:bounded_reweight}'s regimes are stated over) is \textbf  {single-peaked at $r{=}1$} as the theorem predicts (over-attenuated adversaries carry no payload, over-amplified ones are discarded) while reputation is monotone, off-spec and refuted for that shape. Mode~A is the $\Delta _c$-\emph  {swept} companion to Mode~S's $\Delta _c$-pinned design (Proposition~\ref {prop:rho_deltac}); Mode~S itself is Figure~\ref {fig:modeS_dose}. Bars are Student-$t$ $95\%$ intervals; numbers recomputed per seed by \texttt  {analyze\_targeted\_dose.py}.}}{33}{figure.caption.37}\protected@file@percent }
\newlabel{fig:modeA}{{A6}{33}{\textbf {Mode~A, the payload dose: the two mechanism-preserving regimes, and where they hold.} With dispersion fixed and only the adversary/benign weight ratio $r$ swept, \texttt {coord\_median} (a rank aggregator, the case Theorem~\ref {thm:bounded_reweight}'s regimes are stated over) is \textbf {single-peaked at $r{=}1$} as the theorem predicts (over-attenuated adversaries carry no payload, over-amplified ones are discarded) while reputation is monotone, off-spec and refuted for that shape. Mode~A is the $\Delta _c$-\emph {swept} companion to Mode~S's $\Delta _c$-pinned design (Proposition~\ref {prop:rho_deltac}); Mode~S itself is Figure~\ref {fig:modeS_dose}. Bars are Student-$t$ $95\%$ intervals; numbers recomputed per seed by \texttt {analyze\_targeted\_dose.py}}{figure.caption.37}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A7}{\ignorespaces Mode~S (statistic-only), $n{=}5$ per arm ($n{=}8$ for \texttt  {cos\_krum}), per-attack mean ASR with the two measured channels. The decision channel moves far more than ASR throughout. \textbf  {The \emph  {admission} row is the admitted adversarial \emph  {mass} $\Lambda _a$}, i.e.\ Table~\ref {tab:channels}'s influence column $\Delta \Lambda _a$ and \emph  {not} its $\Delta $~adm.\ column, which records the support of that mass and is $0.000$ in every measured round of every arm; this section's hypothesis names (H-admission) are stated at the mass. $^{\dagger }$ below the $0.35$ accuracy gate. $^{\ddagger }$ the pre-registered replication arm, \emph  {rank-discordant} by design (smallest decision change, largest admission change of any interpretable arm) and scored against thresholds frozen separately at \texttt  {06d9bce} before \texttt  {results/dose\_replication/} existed: $\Delta {=}{+}0.098$ falls below reputation's $+0.178$, so the cross-arm admission \emph  {ordering} is refuted while the negative replicates on a different invariance class (below). Verdicts otherwise scored against the readings frozen at \texttt  {5130cec}; per-seed values in the supplement (§\ref {app:dose_detail}).}}{33}{table.caption.38}\protected@file@percent }
\newlabel{tab:targeted}{{A7}{33}{Mode~S (statistic-only), $n{=}5$ per arm ($n{=}8$ for \texttt {cos\_krum}), per-attack mean ASR with the two measured channels. The decision channel moves far more than ASR throughout. \textbf {The \emph {admission} row is the admitted adversarial \emph {mass} $\Lambda _a$}, i.e.\ Table~\ref {tab:channels}'s influence column $\Delta \Lambda _a$ and \emph {not} its $\Delta $~adm.\ column, which records the support of that mass and is $0.000$ in every measured round of every arm; this section's hypothesis names (H-admission) are stated at the mass. $^{\dagger }$ below the $0.35$ accuracy gate. $^{\ddagger }$ the pre-registered replication arm, \emph {rank-discordant} by design (smallest decision change, largest admission change of any interpretable arm) and scored against thresholds frozen separately at \texttt {06d9bce} before \texttt {results/dose\_replication/} existed: $\Delta {=}{+}0.098$ falls below reputation's $+0.178$, so the cross-arm admission \emph {ordering} is refuted while the negative replicates on a different invariance class (below). Verdicts otherwise scored against the readings frozen at \texttt {5130cec}; per-seed values in the supplement (§\ref {app:dose_detail})}{table.caption.38}{}}
