\@writefile{lot}{\contentsline {table}{\numberline {A16}{\ignorespaces \textbf  {TOST against the frozen $\pm 0.15$ margin at the seed counts already on disk}, on the paired per-seed difference (top rung minus identity). Equivalence requires the $90\%$ interval inside the margin, which at $\alpha {=}0.05$ is $\max (p_{\mathrm  {lower}},p_{\mathrm  {upper}}) < 0.05$. Post-hoc; no runs added. Emitted by \texttt  {experiments/analyze\_tost\_existing.py}.}}{48}{table.caption.48}\protected@file@percent }
\newlabel{tab:tost}{{A16}{48}{\textbf {TOST against the frozen $\pm 0.15$ margin at the seed counts already on disk}, on the paired per-seed difference (top rung minus identity). Equivalence requires the $90\%$ interval inside the margin, which at $\alpha {=}0.05$ is $\max (p_{\mathrm {lower}},p_{\mathrm {upper}}) < 0.05$. Post-hoc; no runs added. Emitted by \texttt {experiments/analyze\_tost\_existing.py}}{table.caption.48}{}}
