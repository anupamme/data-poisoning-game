\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces N-sweep: VoPD and ASR across client scales (CIFAR-10, $4{\times }5$ game, $f=0.2$). $P(\geq \!1\,\text  {adv})$ = per-round adversarial participation probability. $^\dagger $ASR binary at $N=10$ (Bernoulli, $P=0.778$). $^\ddagger $K/N-fixed contrast ($N=20$ fixed): raising $K/N$ from 0.20 to 0.50 increases $P$ from 0.624 to 0.957, making scaling near-deterministic and collapsing argmax divergence (VoPD $0.044\to 0.020$, mixed-NE $3/5\to 2/5$); Theorem~\ref {thm:complementarity} correct 5/5 for both.}}{63}{table.caption.50}\protected@file@percent }
\newlabel{tab:n_sweep}{{20}{63}{N-sweep: VoPD and ASR across client scales (CIFAR-10, $4{\times }5$ game, $f=0.2$). $P(\geq \!1\,\text {adv})$ = per-round adversarial participation probability. $^\dagger $ASR binary at $N=10$ (Bernoulli, $P=0.778$). $^\ddagger $K/N-fixed contrast ($N=20$ fixed): raising $K/N$ from 0.20 to 0.50 increases $P$ from 0.624 to 0.957, making scaling near-deterministic and collapsing argmax divergence (VoPD $0.044\to 0.020$, mixed-NE $3/5\to 2/5$); Theorem~\ref {thm:complementarity} correct 5/5 for both}{table.caption.50}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Scale-dependent phase boundary (CIFAR-10, $4{\times }5$ game, $f=0.2$). Left: mean VoPD~$\pm $~std vs.\ $N$, declining overall: $0.048 \to 0.044 \to 0.007 \to 0.002$. Right: ASR(model\_scaling, FedAvg) vs.\ $N$, showing the non-monotone pattern ($N=20$ dips to 0.20 due to lower $K/N=0.20$, then rises past threshold at $N=50$). The per-round adversarial participation probability sequence ($0.778 \to 0.624 \to 0.917 \to 0.993$) directly drives this pattern.}}{63}{figure.caption.51}\protected@file@percent }
\newlabel{fig:n_sweep}{{9}{63}{Scale-dependent phase boundary (CIFAR-10, $4{\times }5$ game, $f=0.2$). Left: mean VoPD~$\pm $~std vs.\ $N$, declining overall: $0.048 \to 0.044 \to 0.007 \to 0.002$. Right: ASR(model\_scaling, FedAvg) vs.\ $N$, showing the non-monotone pattern ($N=20$ dips to 0.20 due to lower $K/N=0.20$, then rises past threshold at $N=50$). The per-round adversarial participation probability sequence ($0.778 \to 0.624 \to 0.917 \to 0.993$) directly drives this pattern}{figure.caption.51}{}}
