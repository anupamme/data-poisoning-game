\@writefile{lot}{\contentsline {table}{\numberline {A8}{\ignorespaces The four arms of the dose--response ladder, and the frozen predictions. The statistic each $d_2$ reads is, in order, summed pairwise Euclidean distance, distance to the client median, pairwise cosine, and coordinate ordering. \emph  {Standalone} is $d_2$'s own ASR (clean accuracy) on that attack, the C1 input, held fixed within every arm. \emph  {Measured disturbance} is the fraction of live rounds on which the rung changes that arm's decision (for \texttt  {coord\_median}, the mean fraction of \emph  {coordinates} whose median-attaining client changes) measured before the freeze on the same raw updates, with no ASR computed (\texttt  {results/dose\_disturbance.json}). Shapes and decision rules are frozen at commit \texttt  {e711a95}.}}{30}{table.caption.29}\protected@file@percent }
\newlabel{tab:dose_design}{{A8}{30}{The four arms of the dose--response ladder, and the frozen predictions. The statistic each $d_2$ reads is, in order, summed pairwise Euclidean distance, distance to the client median, pairwise cosine, and coordinate ordering. \emph {Standalone} is $d_2$'s own ASR (clean accuracy) on that attack, the C1 input, held fixed within every arm. \emph {Measured disturbance} is the fraction of live rounds on which the rung changes that arm's decision (for \texttt {coord\_median}, the mean fraction of \emph {coordinates} whose median-attaining client changes) measured before the freeze on the same raw updates, with no ASR computed (\texttt {results/dose\_disturbance.json}). Shapes and decision rules are frozen at commit \texttt {e711a95}}{table.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A2}{\ignorespaces \textbf  {The ladder and its frozen predictions.} The 16 cells on the nominal dose axis $\rho = e^{2\kappa }$ ($n{=}5$ per point, Student-t 95\% intervals), coloured by Proposition~\ref {prop:invariance} class. Of the two class-(c) arms whose statistics the framework's fragility claim is stated over, only reputation rises; ASR \emph  {falls} with the dose in three of the four arms, against the predicted rises. Hollow markers fail the $0.35$ clean-accuracy gate and are uninterpretable. Drawn by \texttt  {paper/figures/dose\_response\_figure.py}, which recomputes every value from \texttt  {results/} and imports the arm construction from the scoring script so the two cannot diverge.}}{31}{figure.caption.31}\protected@file@percent }
\newlabel{fig:dose_ladder}{{A2}{31}{\textbf {The ladder and its frozen predictions.} The 16 cells on the nominal dose axis $\rho = e^{2\kappa }$ ($n{=}5$ per point, Student-t 95\% intervals), coloured by Proposition~\ref {prop:invariance} class. Of the two class-(c) arms whose statistics the framework's fragility claim is stated over, only reputation rises; ASR \emph {falls} with the dose in three of the four arms, against the predicted rises. Hollow markers fail the $0.35$ clean-accuracy gate and are uninterpretable. Drawn by \texttt {paper/figures/dose\_response\_figure.py}, which recomputes every value from \texttt {results/} and imports the arm construction from the scoring script so the two cannot diverge}{figure.caption.31}{}}
