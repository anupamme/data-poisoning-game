\citation{elwert2014endogenous,pearl2009causality}
\citation{elwert2014endogenous,pearl2009causality}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Why the gate is not ordinary collider bias, which is the whole of the novelty claim.} \textbf  {(a)} Conditioning on a descendant $G$ of both the mechanism $P$ and the defense's standalone strength $S$ makes them co-vary. \textbf  {This half is textbook}~\citep  {elwert2014endogenous,pearl2009causality} \textbf  {and we claim no credit for it}: every cell stays populated, so an adjustment recovers the estimand in principle. \textbf  {(b)} Here C0$\wedge $C1 make the gate \emph  {deterministic} in $S$ (Lemma~\ref {lem:testability}), so the column the identifying contrast needs is \textbf  {empty for every defense menu}, and \textbf  {no adjustment set, no reweighting and no sample size restores it} (Proposition~\ref {prop:identification}).}}{5}{figure.caption.3}\protected@file@percent }
\newlabel{fig:identification}{{2}{5}{\textbf {Why the gate is not ordinary collider bias, which is the whole of the novelty claim.} \textbf {(a)} Conditioning on a descendant $G$ of both the mechanism $P$ and the defense's standalone strength $S$ makes them co-vary. \textbf {This half is textbook}~\citep {elwert2014endogenous,pearl2009causality} \textbf {and we claim no credit for it}: every cell stays populated, so an adjustment recovers the estimand in principle. \textbf {(b)} Here C0$\wedge $C1 make the gate \emph {deterministic} in $S$ (Lemma~\ref {lem:testability}), so the column the identifying contrast needs is \textbf {empty for every defense menu}, and \textbf {no adjustment set, no reweighting and no sample size restores it} (Proposition~\ref {prop:identification})}{figure.caption.3}{}}
