\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Phase boundary of defense complementarity on three independent axes (CIFAR-10, 10 seeds). \textbf  {(a)} Fraction of bootstrap resamples yielding a mixed NE under Gaussian payoff noise $\sigma $: drops from 97.8\% at $\sigma =0$ to 55.8\% at $\sigma =0.05$. \textbf  {(b)} Mixed-NE rate across five defense menus: varies from 0\% (FedAvg+NClip, no argmax divergence) to 60\% (FedAvg+TrMean, strong complementarity). \textbf  {(c)} Bootstrap mixed-NE rate as a function of seeds averaged $k$: rises from 78\% at $k=2$ to 98\% at $k=10$ (purely empirical; Proposition~\ref {thm:sample_complexity_appendix} requires $k\geq 726$ for a formal guarantee at these parameters and is not overlaid).}}{60}{figure.caption.46}\protected@file@percent }
\newlabel{fig:portrait}{{8}{60}{Phase boundary of defense complementarity on three independent axes (CIFAR-10, 10 seeds). \textbf {(a)} Fraction of bootstrap resamples yielding a mixed NE under Gaussian payoff noise $\sigma $: drops from 97.8\% at $\sigma =0$ to 55.8\% at $\sigma =0.05$. \textbf {(b)} Mixed-NE rate across five defense menus: varies from 0\% (FedAvg+NClip, no argmax divergence) to 60\% (FedAvg+TrMean, strong complementarity). \textbf {(c)} Bootstrap mixed-NE rate as a function of seeds averaged $k$: rises from 78\% at $k=2$ to 98\% at $k=10$ (purely empirical; Proposition~\ref {thm:sample_complexity_appendix} requires $k\geq 726$ for a formal guarantee at these parameters and is not overlaid)}{figure.caption.46}{}}
