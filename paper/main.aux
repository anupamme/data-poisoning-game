\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Not ordinary collider bias but a structural \emph  {positivity} violation, which is why the remedy is a design and not an estimator.} \textbf  {(a)} Ordinary collider bias, where every cell stays populated and adjustment recovers the estimand in principle. \textbf  {(b)} The inherited-suppression gate $G{=}E$ is \emph  {deterministic} in $S{=}M(d_2,a)$, so the column the identifying contrast needs is empty and no sample size restores it (Prop.~\ref {prop:identification}). \textbf  {(c)} The repair: hold $d_2$ and $a$ fixed, intervene on $T$, and run $T{=}\mathrm  {id}$ as the control whatever its outcome (Cor.~\ref {cor:within_design}; App.~\ref {app:mapping}).}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:identification}{{2}{3}{\textbf {Not ordinary collider bias but a structural \emph {positivity} violation, which is why the remedy is a design and not an estimator.} \textbf {(a)} Ordinary collider bias, where every cell stays populated and adjustment recovers the estimand in principle. \textbf {(b)} The inherited-suppression gate $G{=}E$ is \emph {deterministic} in $S{=}M(d_2,a)$, so the column the identifying contrast needs is empty and no sample size restores it (Prop.~\ref {prop:identification}). \textbf {(c)} The repair: hold $d_2$ and $a$ fixed, intervene on $T$, and run $T{=}\mathrm {id}$ as the control whatever its outcome (Cor.~\ref {cor:within_design}; App.~\ref {app:mapping})}{figure.caption.3}{}}
