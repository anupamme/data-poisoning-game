\@writefile{lof}{\contentsline {figure}{\numberline {A4}{\ignorespaces \textbf  {Mode~A, the payload dose: the two mechanism-preserving regimes, and where they hold.} With dispersion fixed and only the adversary/benign weight ratio $r$ swept, \texttt  {coord\_median} (a rank aggregator, the case Theorem~\ref {thm:bounded_reweight}'s regimes are stated over) is \textbf  {single-peaked at $r{=}1$} as the theorem predicts (over-attenuated adversaries carry no payload, over-amplified ones are discarded) while reputation is monotone, off-spec and refuted for that shape. Mode~A is the $\Delta _c$-\emph  {swept} companion to Mode~S's $\Delta _c$-pinned design (Proposition~\ref {prop:rho_deltac}); Mode~S itself is Figure~\ref {fig:modeS}. Bars are Student-$t$ $95\%$ intervals; numbers recomputed per seed by \texttt  {analyze\_targeted\_dose.py}.}}{41}{figure.caption.38}\protected@file@percent }
\newlabel{fig:modeA}{{A4}{41}{\textbf {Mode~A, the payload dose: the two mechanism-preserving regimes, and where they hold.} With dispersion fixed and only the adversary/benign weight ratio $r$ swept, \texttt {coord\_median} (a rank aggregator, the case Theorem~\ref {thm:bounded_reweight}'s regimes are stated over) is \textbf {single-peaked at $r{=}1$} as the theorem predicts (over-attenuated adversaries carry no payload, over-amplified ones are discarded) while reputation is monotone, off-spec and refuted for that shape. Mode~A is the $\Delta _c$-\emph {swept} companion to Mode~S's $\Delta _c$-pinned design (Proposition~\ref {prop:rho_deltac}); Mode~S itself is Figure~\ref {fig:modeS}. Bars are Student-$t$ $95\%$ intervals; numbers recomputed per seed by \texttt {analyze\_targeted\_dose.py}}{figure.caption.38}{}}
