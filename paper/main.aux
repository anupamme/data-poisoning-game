\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The ladder and its frozen predictions.} The 16 cells on the nominal dose axis $\rho = e^{2\kappa }$ ($n{=}5$ per point, Student-t 95\% intervals), coloured by Proposition~\ref {prop:invariance} class. Of the two class-(c) arms whose statistics the framework's fragility claim is stated over, only reputation rises; ASR \emph  {falls} with the dose in three of the four arms, against the predicted rises. Hollow markers fail the $0.35$ clean-accuracy gate and are uninterpretable. Drawn by \texttt  {paper/figures/dose\_response\_figure.py}, which recomputes every value from \texttt  {results/} and imports the arm construction from the scoring script so the two cannot diverge.}}{33}{figure.caption.23}\protected@file@percent }
\newlabel{fig:dose_ladder}{{3}{33}{\textbf {The ladder and its frozen predictions.} The 16 cells on the nominal dose axis $\rho = e^{2\kappa }$ ($n{=}5$ per point, Student-t 95\% intervals), coloured by Proposition~\ref {prop:invariance} class. Of the two class-(c) arms whose statistics the framework's fragility claim is stated over, only reputation rises; ASR \emph {falls} with the dose in three of the four arms, against the predicted rises. Hollow markers fail the $0.35$ clean-accuracy gate and are uninterpretable. Drawn by \texttt {paper/figures/dose\_response\_figure.py}, which recomputes every value from \texttt {results/} and imports the arm construction from the scoring script so the two cannot diverge}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Why a transform's flip rate is not a sufficient statistic for what it does.} ASR against the \emph  {independently measured} disturbance of each arm's own statistic ($n{=}5$, Student-t 95\% intervals), the abscissa fixed before the freeze. Stars and crosses are the two \emph  {real} upstream transforms measured on these same $(d_2, \text  {attack})$ cells (NormClip, RFA), placed at their own measured disturbance rate: at matched disturbance they sit $+0.77$ and $+0.79$ ASR \emph  {above} the synthetic curve, while their realized weight ratios (mean $3.61$ and $11.93$, maximum $4.90$ and $17.38$) fall \emph  {inside} the ladder's span---which is why we conclude that flip rate does not determine what a transform does to a defense. The class-(a) arm's four rungs coincide at disturbance exactly $0$ ($0/120$ selections changed, maximum relative score drift $1.1\times 10^{-4}$) and its ASR falls anyway: Lemma~\ref {lem:annihilation}'s magnitude channel, not C2 disturbance.}}{34}{figure.caption.24}\protected@file@percent }
\newlabel{fig:dose_measured}{{4}{34}{\textbf {Why a transform's flip rate is not a sufficient statistic for what it does.} ASR against the \emph {independently measured} disturbance of each arm's own statistic ($n{=}5$, Student-t 95\% intervals), the abscissa fixed before the freeze. Stars and crosses are the two \emph {real} upstream transforms measured on these same $(d_2, \text {attack})$ cells (NormClip, RFA), placed at their own measured disturbance rate: at matched disturbance they sit $+0.77$ and $+0.79$ ASR \emph {above} the synthetic curve, while their realized weight ratios (mean $3.61$ and $11.93$, maximum $4.90$ and $17.38$) fall \emph {inside} the ladder's span---which is why we conclude that flip rate does not determine what a transform does to a defense. The class-(a) arm's four rungs coincide at disturbance exactly $0$ ($0/120$ selections changed, maximum relative score drift $1.1\times 10^{-4}$) and its ASR falls anyway: Lemma~\ref {lem:annihilation}'s magnitude channel, not C2 disturbance}{figure.caption.24}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}The targeted intervention: isolating C2 from the attenuation channel}{34}{subsection.5.2}\protected@file@percent }
\newlabel{sec:targeted}{{5.2}{34}{The targeted intervention: isolating C2 from the attenuation channel}{subsection.5.2}{}}
