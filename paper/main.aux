\@writefile{lot}{\contentsline {table}{\numberline {A16}{\ignorespaces Accuracy--security Pareto frontier. Max ASR = worst-case mean across committed attacks, and Clean Acc is measured on the arm that attains it. All at $N{=}10$, $K{=}5$, $f{=}0.2$, cifar\_cnn. The three composition rows are emitted by \texttt  {experiments/analyze\_headline\_cis.py}: FG$\to $RFA at $n{=}30$ (seeds $42$--$71$), FG$\to $CM and Rep$\to $CM at $n{=}5$ (seeds $42$--$46$). No \emph  {composition} dominates another: FG$\to $CM buys $0.185$ accuracy for $+0.014$ ASR. The single-defense rows are listed for reference and are not all frontier points; \texttt  {Rep alone} dominates \texttt  {RFA alone} on both axes.}}{47}{table.caption.48}\protected@file@percent }
\newlabel{tab:pareto}{{A16}{47}{Accuracy--security Pareto frontier. Max ASR = worst-case mean across committed attacks, and Clean Acc is measured on the arm that attains it. All at $N{=}10$, $K{=}5$, $f{=}0.2$, cifar\_cnn. The three composition rows are emitted by \texttt {experiments/analyze\_headline\_cis.py}: FG$\to $RFA at $n{=}30$ (seeds $42$--$71$), FG$\to $CM and Rep$\to $CM at $n{=}5$ (seeds $42$--$46$). No \emph {composition} dominates another: FG$\to $CM buys $0.185$ accuracy for $+0.014$ ASR. The single-defense rows are listed for reference and are not all frontier points; \texttt {Rep alone} dominates \texttt {RFA alone} on both axes}{table.caption.48}{}}
