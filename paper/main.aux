\@writefile{lof}{\contentsline {figure}{\numberline {A5}{\ignorespaces \textbf  {Mode~A, the payload dose: the two mechanism-preserving regimes, and where they hold.} With dispersion fixed and only the adversary/benign weight ratio $r$ swept, \texttt  {coord\_median} (a rank aggregator, the case Theorem~\ref {thm:bounded_reweight}'s regimes are stated over) is \textbf  {single-peaked at $r{=}1$} as the theorem predicts (over-attenuated adversaries carry no payload, over-amplified ones are discarded) while reputation is monotone, off-spec and refuted for that shape. Mode~A is the $\Delta _c$-\emph  {swept} companion to Mode~S's $\Delta _c$-pinned design (Proposition~\ref {prop:rho_deltac}); Mode~S itself is Figure~\ref {fig:modeS}. Bars are Student-$t$ $95\%$ intervals; numbers recomputed per seed by \texttt  {analyze\_targeted\_dose.py}.}}{38}{figure.caption.35}\protected@file@percent }
\newlabel{fig:modeA}{{A5}{38}{\textbf {Mode~A, the payload dose: the two mechanism-preserving regimes, and where they hold.} With dispersion fixed and only the adversary/benign weight ratio $r$ swept, \texttt {coord\_median} (a rank aggregator, the case Theorem~\ref {thm:bounded_reweight}'s regimes are stated over) is \textbf {single-peaked at $r{=}1$} as the theorem predicts (over-attenuated adversaries carry no payload, over-amplified ones are discarded) while reputation is monotone, off-spec and refuted for that shape. Mode~A is the $\Delta _c$-\emph {swept} companion to Mode~S's $\Delta _c$-pinned design (Proposition~\ref {prop:rho_deltac}); Mode~S itself is Figure~\ref {fig:modeS}. Bars are Student-$t$ $95\%$ intervals; numbers recomputed per seed by \texttt {analyze\_targeted\_dose.py}}{figure.caption.35}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A11}{\ignorespaces Mode~S (statistic-only), $n{=}5$ per arm ($n{=}8$ for \texttt  {cos\_krum}), per-attack mean ASR with the two measured channels. The decision channel moves far more than ASR throughout. $^{\dagger }$ below the $0.35$ accuracy gate. $^{\ddagger }$ the pre-registered replication arm, \emph  {rank-discordant} by design (smallest decision change, largest admission change of any interpretable arm) and scored against thresholds frozen separately at \texttt  {06d9bce} before \texttt  {results/dose\_replication/} existed: $\Delta {=}{+}0.098$ falls below reputation's $+0.178$, so the cross-arm admission \emph  {ordering} is refuted while the negative replicates on a different invariance class (\S  \ref {app:targeted_full}). Verdicts otherwise scored against the readings frozen at \texttt  {5130cec}; per-seed values in the supplement (\S  ~\ref {app:dose_detail}).}}{38}{table.caption.36}\protected@file@percent }
\newlabel{tab:targeted}{{A11}{38}{Mode~S (statistic-only), $n{=}5$ per arm ($n{=}8$ for \texttt {cos\_krum}), per-attack mean ASR with the two measured channels. The decision channel moves far more than ASR throughout. $^{\dagger }$ below the $0.35$ accuracy gate. $^{\ddagger }$ the pre-registered replication arm, \emph {rank-discordant} by design (smallest decision change, largest admission change of any interpretable arm) and scored against thresholds frozen separately at \texttt {06d9bce} before \texttt {results/dose\_replication/} existed: $\Delta {=}{+}0.098$ falls below reputation's $+0.178$, so the cross-arm admission \emph {ordering} is refuted while the negative replicates on a different invariance class (\S \ref {app:targeted_full}). Verdicts otherwise scored against the readings frozen at \texttt {5130cec}; per-seed values in the supplement (\S ~\ref {app:dose_detail})}{table.caption.36}{}}
