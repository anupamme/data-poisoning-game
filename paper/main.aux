\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {The preservation chain, and where it breaks.} (P1)$\Rightarrow $(P2)$\Rightarrow $(P3) holds by definition; \textbf  {the (P3)--(P4) link breaks in both directions}, and both witnesses come from the oracle intervention that pins every adversary's coefficient and so closes Lemma~\ref {lem:annihilation}'s attenuation channel \emph  {by construction} (\S  \ref {sec:targeted}). The pooled statistic-level prediction we had frozen is separately \textbf  {rejected} by a pre-registered ladder ($\rho _s = +0.351$, one-sided $p = 0.091$, $16$ cells; \S  \ref {sec:dose_response}), and a pre-registered replication in a different invariance class reproduces the negative but \textbf  {refutes the cross-arm admission ordering} ($\Delta = +0.098$; the pooled two-channel model stays unconfirmed, $R^2 = 0.239$ over $26$ cells), so \textbf  {admission is a direction, not a validated predictor}. Every number in the figure and in this caption is recomputed from the scoring scripts' own JSON and printed by \texttt  {story\_chain\_figure.py}.}}{50}{figure.caption.41}\protected@file@percent }
\newlabel{fig:story}{{7}{50}{\textbf {The preservation chain, and where it breaks.} (P1)$\Rightarrow $(P2)$\Rightarrow $(P3) holds by definition; \textbf {the (P3)--(P4) link breaks in both directions}, and both witnesses come from the oracle intervention that pins every adversary's coefficient and so closes Lemma~\ref {lem:annihilation}'s attenuation channel \emph {by construction} (\S \ref {sec:targeted}). The pooled statistic-level prediction we had frozen is separately \textbf {rejected} by a pre-registered ladder ($\rho _s = +0.351$, one-sided $p = 0.091$, $16$ cells; \S \ref {sec:dose_response}), and a pre-registered replication in a different invariance class reproduces the negative but \textbf {refutes the cross-arm admission ordering} ($\Delta = +0.098$; the pooled two-channel model stays unconfirmed, $R^2 = 0.239$ over $26$ cells), so \textbf {admission is a direction, not a validated predictor}. Every number in the figure and in this caption is recomputed from the scoring scripts' own JSON and printed by \texttt {story\_chain\_figure.py}}{figure.caption.41}{}}
