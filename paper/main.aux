\@writefile{lof}{\contentsline {figure}{\numberline {A2}{\ignorespaces \textbf  {The ladder and its frozen predictions.} The 16 cells on the nominal dose axis $\rho = e^{2\kappa }$ ($n{=}5$ per point, Student-t 95\% intervals), coloured by Proposition~\ref {prop:invariance} class. Of the two class-(c) arms whose statistics the framework's fragility claim is stated over, only reputation rises; ASR \emph  {falls} with the dose in three of the four arms, against the predicted rises. Hollow markers fail the $0.35$ clean-accuracy gate and are uninterpretable. Drawn by \texttt  {paper/figures/dose\_response\_figure.py}, which recomputes every value from \texttt  {results/} and imports the arm construction from the scoring script so the two cannot diverge.}}{39}{figure.caption.36}\protected@file@percent }
\newlabel{fig:dose_ladder}{{A2}{39}{\textbf {The ladder and its frozen predictions.} The 16 cells on the nominal dose axis $\rho = e^{2\kappa }$ ($n{=}5$ per point, Student-t 95\% intervals), coloured by Proposition~\ref {prop:invariance} class. Of the two class-(c) arms whose statistics the framework's fragility claim is stated over, only reputation rises; ASR \emph {falls} with the dose in three of the four arms, against the predicted rises. Hollow markers fail the $0.35$ clean-accuracy gate and are uninterpretable. Drawn by \texttt {paper/figures/dose\_response\_figure.py}, which recomputes every value from \texttt {results/} and imports the arm construction from the scoring script so the two cannot diverge}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A3}{\ignorespaces \textbf  {Why a transform's flip rate is not a sufficient statistic for what it does.} ASR against the \emph  {independently measured} disturbance of each arm's own statistic ($n{=}5$, Student-t 95\% intervals), the abscissa fixed before the freeze. Stars and crosses are the two \emph  {real} upstream transforms measured on these same $(d_2, \text  {attack})$ cells (NormClip, RFA), placed at their own measured disturbance rate: at matched disturbance they sit $+0.77$ and $+0.79$ ASR \emph  {above} the synthetic curve, while their realized weight ratios (mean $3.61$ and $11.93$, maximum $4.90$ and $17.38$) fall \emph  {inside} the ladder's span. The class-(a) arm's four rungs coincide at disturbance exactly $0$ ($0/120$ selections changed, maximum relative score drift $1.1\times 10^{-4}$) and its ASR falls anyway: Lemma~\ref {lem:annihilation}'s magnitude channel, not C2 disturbance.}}{40}{figure.caption.37}\protected@file@percent }
\newlabel{fig:dose_measured}{{A3}{40}{\textbf {Why a transform's flip rate is not a sufficient statistic for what it does.} ASR against the \emph {independently measured} disturbance of each arm's own statistic ($n{=}5$, Student-t 95\% intervals), the abscissa fixed before the freeze. Stars and crosses are the two \emph {real} upstream transforms measured on these same $(d_2, \text {attack})$ cells (NormClip, RFA), placed at their own measured disturbance rate: at matched disturbance they sit $+0.77$ and $+0.79$ ASR \emph {above} the synthetic curve, while their realized weight ratios (mean $3.61$ and $11.93$, maximum $4.90$ and $17.38$) fall \emph {inside} the ladder's span. The class-(a) arm's four rungs coincide at disturbance exactly $0$ ($0/120$ selections changed, maximum relative score drift $1.1\times 10^{-4}$) and its ASR falls anyway: Lemma~\ref {lem:annihilation}'s magnitude channel, not C2 disturbance}{figure.caption.37}{}}
