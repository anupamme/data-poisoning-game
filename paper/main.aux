\@writefile{toc}{\contentsline {paragraph}{Mode~M: coordinate masking, a second transformation class.}{39}{section*.42}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {A12}{\ignorespaces \textbf  {The same aggregators under two transformation classes, every prediction frozen before its measurement.} Prop.~\ref {prop:invariance} classifies aggregators under \emph  {positive per-client rescaling} only; coordinate masking is outside that family, so Thm.~\ref {thm:bounded_reweight} and Prop.~\ref {prop:invariance} make \textbf  {no} prediction there, which is what makes the second class a test rather than a second demonstration. Rescaling predictions were frozen at \texttt  {5130cec}, masking predictions at \texttt  {684b31e}, each before the corresponding run existed; \texttt  {experiments/build\_prediction\_matrix.py} refuses to emit if any observed cell disagrees with its frozen document. \textbf  {\texttt  {cos\_krum} is the adjudicating row}: exactly invariant under rescaling, its selection bit-identical at every rung, it loses the guarantee under masking on the same attack and the same seeds, which is what it means for the classification to be a statement about a transformation \emph  {class} and not about an aggregator. Masking ASR is measured for \texttt  {krum} only (\S  ~\ref {app:channel_table}); the other three masking cells are channel results and are marked \texttt  {---}.}}{40}{table.caption.43}\protected@file@percent }
\newlabel{tab:prediction_matrix}{{A12}{40}{\textbf {The same aggregators under two transformation classes, every prediction frozen before its measurement.} Prop.~\ref {prop:invariance} classifies aggregators under \emph {positive per-client rescaling} only; coordinate masking is outside that family, so Thm.~\ref {thm:bounded_reweight} and Prop.~\ref {prop:invariance} make \textbf {no} prediction there, which is what makes the second class a test rather than a second demonstration. Rescaling predictions were frozen at \texttt {5130cec}, masking predictions at \texttt {684b31e}, each before the corresponding run existed; \texttt {experiments/build\_prediction\_matrix.py} refuses to emit if any observed cell disagrees with its frozen document. \textbf {\texttt {cos\_krum} is the adjudicating row}: exactly invariant under rescaling, its selection bit-identical at every rung, it loses the guarantee under masking on the same attack and the same seeds, which is what it means for the classification to be a statement about a transformation \emph {class} and not about an aggregator. Masking ASR is measured for \texttt {krum} only (\S ~\ref {app:channel_table}); the other three masking cells are channel results and are marked \texttt {---}}{table.caption.43}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {E.3}Six cells, and a pre-registered mechanism that did not survive them}{40}{subsection.E.3}\protected@file@percent }
\newlabel{app:sixcell}{{E.3}{40}{Six cells, and a pre-registered mechanism that did not survive them}{subsection.E.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A13}{\ignorespaces \textbf  {The confounded ladder against the Mode-S instrument, on six cells.} $\Delta $~ASR from $\kappa {=}0$ to $\kappa {=}2$, paired $95\%$ $t$ intervals, each design at its own full $n$. \textbf  {AGREE} := intervals overlap and point estimates share a sign, or both lie within $\pm 0.05$ of zero; \textbf  {DISAGREE} := intervals disjoint or signs opposite; \textbf  {SIGN REVERSAL} := signs differ \emph  {and} both intervals exclude zero. The four unmarked cells are the training data the rule was read off. \textbf  {The rule predicted AGREE for the EMNIST cell and the designs disagree, so it is refuted}; per the frozen clause it is withdrawn, the four-cell pattern is demoted to a description, and the table is reported in full. Every cell emitted by \texttt  {analyze\_comparability.py}.}}{41}{table.caption.44}\protected@file@percent }
\newlabel{tab:sixcell}{{A13}{41}{\textbf {The confounded ladder against the Mode-S instrument, on six cells.} $\Delta $~ASR from $\kappa {=}0$ to $\kappa {=}2$, paired $95\%$ $t$ intervals, each design at its own full $n$. \textbf {AGREE} := intervals overlap and point estimates share a sign, or both lie within $\pm 0.05$ of zero; \textbf {DISAGREE} := intervals disjoint or signs opposite; \textbf {SIGN REVERSAL} := signs differ \emph {and} both intervals exclude zero. The four unmarked cells are the training data the rule was read off. \textbf {The rule predicted AGREE for the EMNIST cell and the designs disagree, so it is refuted}; per the frozen clause it is withdrawn, the four-cell pattern is demoted to a description, and the table is reported in full. Every cell emitted by \texttt {analyze\_comparability.py}}{table.caption.44}{}}
