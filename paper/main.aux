\@writefile{toc}{\contentsline {section}{\numberline {L}Equivalence testing at the existing seed counts: where the frozen margin passes and where it only appears to}{65}{appendix.L}\protected@file@percent }
\newlabel{app:tost}{{L}{65}{Equivalence testing at the existing seed counts: where the frozen margin passes and where it only appears to}{appendix.L}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A21}{\ignorespaces \textbf  {TOST against the frozen $\pm 0.15$ margin at the seed counts already on disk}, on the paired per-seed difference (top rung minus identity). Equivalence requires the $90\%$ interval inside the margin, which at $\alpha {=}0.05$ is $\max (p_{\mathrm  {lower}},p_{\mathrm  {upper}}) < 0.05$. $^{\dagger }$ \textbf  {equivalent \emph  {and} detected}: the $95\%$ interval also excludes zero, so the verdict means ``no effect larger than $0.15$'', \textbf  {never} ``no effect''. Those two readings are not exclusive and the marker exists so a checkmark cannot be read as the stronger one; on the CIFAR-100 row the paper reports a \emph  {measured rise} (§\ref {app:sixcell}) and this row does not retract it. \textbf  {One row's $95\%$ interval is itself wider than the margin}: ResNet18's $[-0.183,+0.101]$. TOST at $\alpha {=}0.05$ reads the $90\%$ interval, so that row passes the test defined here while failing the $95\%$-interval criterion §\ref {app:sensitivity}'s margin ladder uses; both readings are disclosed at §\ref {app:resnet18_dose}, and the two conventions are not interchangeable. Post-hoc; no runs added. Emitted by \texttt  {experiments/analyze\_tost\_existing.py}.}}{66}{table.caption.58}\protected@file@percent }
\newlabel{tab:tost}{{A21}{66}{\textbf {TOST against the frozen $\pm 0.15$ margin at the seed counts already on disk}, on the paired per-seed difference (top rung minus identity). Equivalence requires the $90\%$ interval inside the margin, which at $\alpha {=}0.05$ is $\max (p_{\mathrm {lower}},p_{\mathrm {upper}}) < 0.05$. $^{\dagger }$ \textbf {equivalent \emph {and} detected}: the $95\%$ interval also excludes zero, so the verdict means ``no effect larger than $0.15$'', \textbf {never} ``no effect''. Those two readings are not exclusive and the marker exists so a checkmark cannot be read as the stronger one; on the CIFAR-100 row the paper reports a \emph {measured rise} (§\ref {app:sixcell}) and this row does not retract it. \textbf {One row's $95\%$ interval is itself wider than the margin}: ResNet18's $[-0.183,+0.101]$. TOST at $\alpha {=}0.05$ reads the $90\%$ interval, so that row passes the test defined here while failing the $95\%$-interval criterion §\ref {app:sensitivity}'s margin ladder uses; both readings are disclosed at §\ref {app:resnet18_dose}, and the two conventions are not interchangeable. Post-hoc; no runs added. Emitted by \texttt {experiments/analyze\_tost\_existing.py}}{table.caption.58}{}}
\@writefile{lot}{\contentsline {table}{\numberline {A22}{\ignorespaces \textbf  {The frozen $\pm 0.15$ is not load-bearing: every equivalence reading in the comparability table survives the whole ladder.} \text  {$\mathsurround \z@ \mathchar "458$}\ if the arm's \emph  {controlled} $95\%$ interval lies inside $[-m,+m]$; $m^\ast $ is the smallest margin at which it does. An arm is scored only where the paper makes an equivalence reading, that is where its interval contains zero, and the others are marked absent (---) because their verdict is a detected effect and reads no margin at all. The one row marked $\times $ at every rung, reputation / scaling, is scored because its interval contains zero, but that interval is too wide ($[-0.112,+0.469]$) for any margin here and the paper makes no equivalence claim about that arm, so the headline above is not contradicted by it. \textbf  {These are the controlled intervals of the comparability design} (§\ref {app:sixcell}), \emph  {not} Table~\ref {tab:tost}'s paired $90\%$ TOST intervals: the two differ by design and by seed count, so Krum / scaling is $n{=}20$ here against $n{=}5$ there, and \texttt  {coord\_median} / pixel is $n{=}20$ here (both legs, after the pre-registered endpoint top-up, seeds $47$--$61$) against the frozen $n{=}5$ there. Two absent arms have $m^\ast $ inside the ladder's own span ($0.155$ and $0.110$), named here so the absence cannot be mistaken for a hidden flip. \textbf  {One arm of the paper is not in this artifact at all}: the \texttt  {resnet18} replication (§\ref {app:resnet18_dose}) has only the controlled leg and so no comparability cell, and its own $m^\ast $ is $0.183$, \emph  {wider} than the frozen margin. The emitter derives and prints that number beside this table, so the ladder cannot be read as covering it. Emitted by \texttt  {experiments/analyze\_margin\_sensitivity.py} part (D); the fuller sweep, including the $\pm 0.05$ AGREE tolerance over all of $[0,1]$, is supplement §\ref {app:sensitivity}.}}{66}{table.caption.59}\protected@file@percent }
\newlabel{tab:margin_ladder}{{A22}{66}{\textbf {The frozen $\pm 0.15$ is not load-bearing: every equivalence reading in the comparability table survives the whole ladder.} \checkmark \ if the arm's \emph {controlled} $95\%$ interval lies inside $[-m,+m]$; $m^\ast $ is the smallest margin at which it does. An arm is scored only where the paper makes an equivalence reading, that is where its interval contains zero, and the others are marked absent (---) because their verdict is a detected effect and reads no margin at all. The one row marked $\times $ at every rung, reputation / scaling, is scored because its interval contains zero, but that interval is too wide ($[-0.112,+0.469]$) for any margin here and the paper makes no equivalence claim about that arm, so the headline above is not contradicted by it. \textbf {These are the controlled intervals of the comparability design} (§\ref {app:sixcell}), \emph {not} Table~\ref {tab:tost}'s paired $90\%$ TOST intervals: the two differ by design and by seed count, so Krum / scaling is $n{=}20$ here against $n{=}5$ there, and \texttt {coord\_median} / pixel is $n{=}20$ here (both legs, after the pre-registered endpoint top-up, seeds $47$--$61$) against the frozen $n{=}5$ there. Two absent arms have $m^\ast $ inside the ladder's own span ($0.155$ and $0.110$), named here so the absence cannot be mistaken for a hidden flip. \textbf {One arm of the paper is not in this artifact at all}: the \texttt {resnet18} replication (§\ref {app:resnet18_dose}) has only the controlled leg and so no comparability cell, and its own $m^\ast $ is $0.183$, \emph {wider} than the frozen margin. The emitter derives and prints that number beside this table, so the ladder cannot be read as covering it. Emitted by \texttt {experiments/analyze\_margin\_sensitivity.py} part (D); the fuller sweep, including the $\pm 0.05$ AGREE tolerance over all of $[0,1]$, is supplement §\ref {app:sensitivity}}{table.caption.59}{}}
