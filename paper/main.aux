\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The paper in one figure. Preserving the statistic a downstream defense reads does not identify preserved attack suppression.} \textbf  {(a)} The chain a preservation check reasons along, at the levels of Def.~\ref {def:levels}: both solid links hold \emph  {by definition} (§\ref {sec:framework}), each dashed link is marked $\nRightarrow $ for not implied, and the lower arc is the attenuation channel Mode~S (§\ref {sec:targeted}) cuts by construction. Its three numbers are three scopes, not one experiment (App.~\ref {app:story}): the rounds in which Krum's decision flips, the rounds in which admission is unchanged, pooled over four CIFAR-10 arms rather than Krum alone, and the fall in \texttt  {cos\_krum}'s ASR. \textbf  {(b)} Krum under model scaling (§\ref {sec:targeted}): the \emph  {decision} flips in up to $80\%$ of rounds while admission does not, and ASR stays inside the pre-registered $\pm 0.15$ margin (Student-$t$ $95\%$ bars, $n{=}5$). \textbf  {(c)} Seven cells, one contrast each, estimated both ways (App.~\ref {app:sixcell}): the design choice changes the answer on $5$ of $7$ and its \emph  {sign} on $2$, both \texttt  {coord\_median}/pixel on the two datasets it was run on; the panel marks those rows \emph  {sign reversal} and prints both means. Row labels carry $n$ per cell, outcome-gated/Mode~S where the two differ. The four cells above the dashed rule are training data for a since-withdrawn rule rather than evidence for it (Table~\ref {tab:sixcell}).}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:modeS}{{1}{2}{\textbf {The paper in one figure. Preserving the statistic a downstream defense reads does not identify preserved attack suppression.} \textbf {(a)} The chain a preservation check reasons along, at the levels of Def.~\ref {def:levels}: both solid links hold \emph {by definition} (§\ref {sec:framework}), each dashed link is marked $\nRightarrow $ for not implied, and the lower arc is the attenuation channel Mode~S (§\ref {sec:targeted}) cuts by construction. Its three numbers are three scopes, not one experiment (App.~\ref {app:story}): the rounds in which Krum's decision flips, the rounds in which admission is unchanged, pooled over four CIFAR-10 arms rather than Krum alone, and the fall in \texttt {cos\_krum}'s ASR. \textbf {(b)} Krum under model scaling (§\ref {sec:targeted}): the \emph {decision} flips in up to $80\%$ of rounds while admission does not, and ASR stays inside the pre-registered $\pm 0.15$ margin (Student-$t$ $95\%$ bars, $n{=}5$). \textbf {(c)} Seven cells, one contrast each, estimated both ways (App.~\ref {app:sixcell}): the design choice changes the answer on $5$ of $7$ and its \emph {sign} on $2$, both \texttt {coord\_median}/pixel on the two datasets it was run on; the panel marks those rows \emph {sign reversal} and prints both means. Row labels carry $n$ per cell, outcome-gated/Mode~S where the two differ. The four cells above the dashed rule are training data for a since-withdrawn rule rather than evidence for it (Table~\ref {tab:sixcell})}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Not ordinary collider bias but a structural \emph  {positivity} violation, which is why the remedy is a design and not an estimator.} \textbf  {(a)} Ordinary collider bias, where every cell stays populated and adjustment recovers the estimand in principle. \textbf  {(b)} The inherited-suppression gate makes $G$ \emph  {deterministic} in $S$, so the column the identifying contrast needs is empty and no sample size restores it (Prop.~\ref {prop:identification}). \textbf  {(c)} The repair: hold $d_2$ and $a$ fixed, intervene on $T$, and run $T{=}\mathrm  {id}$ as the control whatever its outcome (Cor.~\ref {cor:within_design}; App.~\ref {app:mapping}).}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:identification}{{2}{3}{\textbf {Not ordinary collider bias but a structural \emph {positivity} violation, which is why the remedy is a design and not an estimator.} \textbf {(a)} Ordinary collider bias, where every cell stays populated and adjustment recovers the estimand in principle. \textbf {(b)} The inherited-suppression gate makes $G$ \emph {deterministic} in $S$, so the column the identifying contrast needs is empty and no sample size restores it (Prop.~\ref {prop:identification}). \textbf {(c)} The repair: hold $d_2$ and $a$ fixed, intervene on $T$, and run $T{=}\mathrm {id}$ as the control whatever its outcome (Cor.~\ref {cor:within_design}; App.~\ref {app:mapping})}{figure.caption.2}{}}
