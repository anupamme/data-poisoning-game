\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {The four channels, all four aggregators, under Mode~S}; endpoint change $\kappa {=}0 \to \kappa {=}2$. $\Delta $~agg.\ is the relative displacement of the aggregate the defense \emph  {emits}, $\|\mathrm  {agg}(T(U)) - \mathrm  {agg}(U)\|/\|\mathrm  {agg}(U)\|$, so it is what enters training and \emph  {not} the value of a scoring statistic. $\Delta $~adm.\ is the \emph  {support} of the admitted adversarial mass and $\Delta \Lambda _a$ is the separate influence question, the weight the adversary's direction carries; the two are never interchangeable. Admission never moves in any measured round of any arm. The table does \emph  {not} order the arms, $\Delta \Lambda _a$ and $\Delta $ASR disagreeing in rank. Per-row provenance, the round counts, and the emitter are in App.~\ref {app:channel_table}.}}{7}{table.caption.7}\protected@file@percent }
\newlabel{tab:channels}{{1}{7}{\textbf {The four channels, all four aggregators, under Mode~S}; endpoint change $\kappa {=}0 \to \kappa {=}2$. $\Delta $~agg.\ is the relative displacement of the aggregate the defense \emph {emits}, $\|\mathrm {agg}(T(U)) - \mathrm {agg}(U)\|/\|\mathrm {agg}(U)\|$, so it is what enters training and \emph {not} the value of a scoring statistic. $\Delta $~adm.\ is the \emph {support} of the admitted adversarial mass and $\Delta \Lambda _a$ is the separate influence question, the weight the adversary's direction carries; the two are never interchangeable. Admission never moves in any measured round of any arm. The table does \emph {not} order the arms, $\Delta \Lambda _a$ and $\Delta $ASR disagreeing in rank. Per-row provenance, the round counts, and the emitter are in App.~\ref {app:channel_table}}{table.caption.7}{}}
