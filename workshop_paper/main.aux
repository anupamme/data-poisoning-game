\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The preservation chain, and where it breaks.} (P1)$\Rightarrow $(P2)$\Rightarrow $(P3) holds by definition; \textbf  {the (P3)--(P4) link breaks in both directions}, and both witnesses come from the oracle intervention that pins every adversary's coefficient and so closes Lemma~\ref {lem:annihilation}'s attenuation channel \emph  {by construction} (\S  \ref {sec:targeted}). The pooled statistic-level prediction we had frozen is separately \textbf  {rejected} by a pre-registered ladder (\S  \ref {sec:dose_response}), and a pre-registered replication in a different invariance class reproduces the negative but \textbf  {refutes the cross-arm admission ordering}, so \textbf  {admission is a direction, not a validated predictor}. Every number in the figure is recomputed from the scoring scripts' own JSON by \texttt  {story\_chain\_figure.py}.}}{29}{figure.2}\protected@file@percent }
\newlabel{fig:story}{{2}{29}{\textbf {The preservation chain, and where it breaks.} (P1)$\Rightarrow $(P2)$\Rightarrow $(P3) holds by definition; \textbf {the (P3)--(P4) link breaks in both directions}, and both witnesses come from the oracle intervention that pins every adversary's coefficient and so closes Lemma~\ref {lem:annihilation}'s attenuation channel \emph {by construction} (\S \ref {sec:targeted}). The pooled statistic-level prediction we had frozen is separately \textbf {rejected} by a pre-registered ladder (\S \ref {sec:dose_response}), and a pre-registered replication in a different invariance class reproduces the negative but \textbf {refutes the cross-arm admission ordering}, so \textbf {admission is a direction, not a validated predictor}. Every number in the figure is recomputed from the scoring scripts' own JSON by \texttt {story\_chain\_figure.py}}{figure.2}{}}
